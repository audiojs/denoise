{
  "name": "@audio/denoise-repair",
  "version": "0.4.0",
  "description": "Spectral repair: rebuild dropouts and damaged time×frequency regions by AR interpolation, a sinusoidal bridge or a similarity transplant, routed by length and content (iZotope RX class)",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "audio",
    "dsp",
    "restoration",
    "spectral-repair",
    "audio-inpainting",
    "packet-loss-concealment",
    "dropout"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "repair.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./repair.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "repair.js",
    "index.d.ts"
  ],
  "types": "index.d.ts",
  "dependencies": {
    "fourier-transform": "^2.3.0",
    "@audio/stft": "^2.0.0",
    "@audio/lpc": "^1.1.0",
    "@audio/sinusoidal-track": "^1.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-repair"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
