{
  "name": "@audio/denoise-debleed",
  "version": "0.1.0",
  "description": "De-bleed: a source's spill taken out of another microphone, given that source's own track. A Kalman filter cancels it through the room path it learns, a Wiener gain takes the residual it predicts",
  "type": "module",
  "sideEffects": false,
  "main": "debleed.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./debleed.js"
    },
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "debleed.js",
    "audio.js",
    "index.d.ts",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/noise-estimate": "^2.3.0",
    "fourier-transform": "^2.4.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "denoise",
    "restoration",
    "debleed",
    "bleed",
    "spill",
    "crosstalk",
    "echo-cancellation"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-debleed"
  },
  "homepage": "https://github.com/audiojs/denoise/tree/main/packages/denoise-debleed",
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
