{
  "name": "@audio/denoise-decrackle",
  "version": "0.4.0",
  "description": "De-crackle: dense small impulses found as outliers of both the AR prediction error and the two-sided error, all of a window rebuilt at once by least-squares AR interpolation, looked for again until none is new, each event kept only where an impulse added to the sound explains it better than the sound's own excitation, the sound around them made robust by EM under impulsive noise",
  "type": "module",
  "sideEffects": false,
  "main": "decrackle.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./decrackle.js"
    },
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "decrackle.js",
    "audio.js",
    "index.d.ts",
    "audio.d.ts"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "dependencies": {
    "@audio/lpc": "^1.2.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "denoise",
    "restoration",
    "decrackle"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-decrackle"
  },
  "homepage": "https://github.com/audiojs/denoise/tree/main/packages/denoise-decrackle",
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
