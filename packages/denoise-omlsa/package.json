{
  "name": "@audio/denoise-omlsa",
  "version": "0.5.0",
  "description": "OM-LSA: Optimally Modified Log-Spectral Amplitude (Cohen & Berdugo 2001), with IMCRA noise (Cohen 2003) or a noise learned where it plays alone",
  "type": "module",
  "sideEffects": false,
  "main": "omlsa.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./omlsa.js"
    },
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "omlsa.js",
    "audio.js",
    "index.d.ts",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/noise-estimate": "^2.3.0",
    "@audio/stft": "^2.0.0",
    "fourier-transform": "^2.3.0"
  },
  "devDependencies": {
    "audio-lena": "^3.0.1",
    "tst": "^9.4.0"
  },
  "scripts": {
    "test": "node test.js"
  },
  "keywords": [
    "audio",
    "dsp",
    "denoise",
    "restoration",
    "omlsa"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-omlsa"
  },
  "homepage": "https://github.com/audiojs/denoise/tree/main/packages/denoise-omlsa",
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
