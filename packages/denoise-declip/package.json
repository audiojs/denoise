{
  "name": "@audio/denoise-declip",
  "version": "0.4.0",
  "description": "De-clip: each side's rail found where the sound was cut flat, or where lossy coding spread the cut into a band, every clipped sample rebuilt three times, AR (Janssen) and sparse (A-SPADE) over 93 and 186 ms, the three blended by weights cross-validated region by region; unclipped sound untouched",
  "type": "module",
  "sideEffects": false,
  "main": "declip.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./declip.js"
    },
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "declip.js",
    "audio.js",
    "index.d.ts",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/lpc": "^1.2.0",
    "fourier-transform": "^2.4.0"
  },
  "scripts": {
    "test": "node test.js"
  },
  "keywords": [
    "audio",
    "dsp",
    "denoise",
    "restoration",
    "declip"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-declip"
  },
  "homepage": "https://github.com/audiojs/denoise/tree/main/packages/denoise-declip",
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
