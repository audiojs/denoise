{
  "name": "@audio/denoise-debreath",
  "version": "0.3.0",
  "description": "De-breath: breaths between phrases taken down, told by their length, level and the pauses either side; the room and the speech stay",
  "type": "module",
  "sideEffects": false,
  "main": "debreath.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./debreath.js"
    },
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "debreath.js",
    "audio.js",
    "index.d.ts",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/biquad": "^1.1.0",
    "@audio/vad": "^2.0.1"
  },
  "keywords": [
    "audio",
    "dsp",
    "denoise",
    "restoration",
    "debreath"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-debreath"
  },
  "homepage": "https://github.com/audiojs/denoise/tree/main/packages/denoise-debreath",
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
