{
  "name": "@audio/denoise-dereverb",
  "version": "0.4.0",
  "description": "De-reverb: late reverberation off a voice, one channel: weighted prediction error (WPE, Nakatani et al. 2010) fitted over the take, then the late power the past carries, scaled by the take's own decays, taken by a gain; a dry take or music passes untouched",
  "type": "module",
  "sideEffects": false,
  "main": "dereverb.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dereverb.js"
    },
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "dereverb.js",
    "audio.js",
    "index.d.ts",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/stft": "^2.0.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "denoise",
    "restoration",
    "dereverb"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git",
    "directory": "packages/denoise-dereverb"
  },
  "homepage": "https://github.com/audiojs/denoise/tree/main/packages/denoise-dereverb",
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
