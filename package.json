{
  "name": "@audio/denoise",
  "version": "0.12.0",
  "type": "module",
  "description": "Noise reduction and restoration: gate, spectral subtraction, Wiener, OM-LSA, dehum, declick, decrackle, declip, dewind, deplosive, deesser, debreath, dereverb, debleed, dewow, desqueak",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "*.d.ts",
    "members/"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "measure": "node scripts/measure.js",
    "publish:all": "node ../compile/tools/tested.js && npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node ../compile/tools/tested.js && node scripts/members.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/denoise.git"
  },
  "keywords": [
    "noise-reduction",
    "denoise",
    "dehum",
    "declick",
    "decrackle",
    "declip",
    "deesser",
    "dereverb",
    "spectral-subtraction",
    "wiener",
    "om-lsa",
    "imcra",
    "audio",
    "audiojs",
    "dsp",
    "speech-enhancement",
    "signal-processing"
  ],
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@audio/vad": "^2.0.1",
    "@audio/noise-estimate": "^2.4.0",
    "@audio/denoise-spectral": "^0.4.0",
    "@audio/denoise-wiener": "^0.5.0",
    "@audio/denoise-omlsa": "^0.7.0",
    "@audio/denoise-dehum": "^0.7.2",
    "@audio/denoise-declick": "^0.4.0",
    "@audio/denoise-decrackle": "^0.4.0",
    "@audio/denoise-declip": "^0.5.1",
    "@audio/denoise-dewind": "^0.5.0",
    "@audio/denoise-deplosive": "^0.4.0",
    "@audio/denoise-debreath": "^0.4.0",
    "@audio/denoise-dereverb": "^0.6.0",
    "@audio/denoise-detect": "^0.8.0",
    "@audio/dynamics-gate": "^0.1.4",
    "@audio/denoise-repair": "^0.4.0",
    "@audio/quality": "^1.0.0",
    "@audio/stft": "^2.0.0",
    "@audio/denoise-desilence": "^0.2.1",
    "@audio/denoise-debleed": "^0.3.0",
    "@audio/denoise-dewow": "^0.3.0",
    "@audio/denoise-desqueak": "^0.4.0"
  },
  "devDependencies": {
    "audio-lena": "^3.0.0",
    "playwright": "^1.59.1",
    "tst": "^9.4.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/audiojs/denoise/issues"
  },
  "homepage": "https://github.com/audiojs/denoise#readme",
  "main": "index.js",
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
